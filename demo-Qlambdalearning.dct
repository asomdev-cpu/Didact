    anim    : [agent [move(to=(40%, 61%), 0.5s), move(to=(40%, 50%), 0.5s)], qc_mw fill(to=#FED7AA, 0.5s)]
    comment : ["Deuxième pas. En M, la politique de comportement explore : elle choisit attendre. Ce n'est pas l'action gloutonne, car 3 est plus grand que 0,5."]
}

149.000 => {
    start   : [p2_b fadein(0.8s)]
    anim    : [tSA to(0, 0.8s, ease=smooth), tMW to(1, 0.8s, ease=smooth), ec_sa fill(to=white, 0.5s), ec_mw fill(to=#FDE68A, 0.5s)]
    comment : ["Règle de Watkins : on coupe la trace. Le passé est oublié, et la trace ne garde que la case M attendre."]
}

156.000 => {
