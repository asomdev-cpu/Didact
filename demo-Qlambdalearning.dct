# ─────────────────────────────────────────────
#  Q(λ)-learning de Watkins : apprendre Q* en explorant
#  LINMA2222 — Chapitre 3.5.6 (environ 6 minutes)
#  didact demo-Qlambdalearning.dct
#
#  Plan :
#   1. De TD(λ)-PI à Q(λ) : la cible devient gloutonne
#   2. Off-policy : politique de comportement vs politique cible
#   3. Un exemple : chaîne S → M → but, deux actions par état
#   4. Pas 1 : action gloutonne, cible avec le min
#   5. Pas 2 : exploration → la trace est coupée
#   6. Pas 3 : retour au glouton, la trace repart
#   7. Convergence vers Q* et politique optimale
#   8. L'algorithme complet
#   9. TD(λ)-PI vs Q(λ), limites
#  10. Récapitulatif
# ─────────────────────────────────────────────

[config]
window       : [16:9]
background   : white
languages    : [FR]
default_lang : FR
decimal      : comma

[figures]

# ═════════════ Styles ═════════════

defstyle titre_scene =
    size  : 46px
    color : #1E3A8A

defstyle formule =
    size : 40px

defstyle note =
    size  : 30px
    color : #4B5563

defstyle noeud =
    radius : 3.5%
    fill   : white
    color  : #374151
    stroke : 3px
    layer  : 2

defstyle fleche =
    color  : #6B7280
    stroke : 3px
    arrow  : end

defstyle boucle =
    color  : #7C3AED
    stroke : 3px
    arrow  : end

defstyle barre_av =
    fill  : #2563EB
    color : #1D4ED8
    layer : 1

defstyle barre_att =
    fill  : #7C3AED
    color : #6D28D9
    layer : 1

defstyle valeur =
    size : 24px

defstyle calcul =
    size : 32px

# ═════════════ Paramètres ═════════════

# Estimations Q(état, action) : av = avancer, att = attendre
defparam SA = 2
defparam SW = 4
defparam MA = 0.5
defparam MW = 3

# Trace d'éligibilité sur chaque couple (état, action)
defparam tSA = 0
defparam tSW = 0
defparam tMA = 0
defparam tMW = 0

# ═════════════ 0. Titre ═════════════

deffigure titre =
    type    : text
    content : "Q($\lambda$)-learning"
    pos     : (50%, 58%)
    size    : 80px
    color   : #1E3A8A

deffigure sous_titre =
    type    : text
    content : "Apprendre $Q^\star$ directement, tout en explorant"
    pos     : (50%, 44%)
    size    : 42px
    color   : #4B5563

deffigure source =
    type    : text
    content : "LINMA2222 — Chapitre 3.5.6 — algorithme de Watkins"
    pos     : (50%, 34%)
    size    : 30px
    color   : #9CA3AF

defgroup g_titre =
    items : [titre, sous_titre, source]

# ═════════════ 1. De TD(λ)-PI à Q(λ) ═════════════

deffigure s1_titre =
    type    : text
    content : "Une seule différence : la cible"
    pos     : (50%, 91%)
    style   : titre_scene

deffigure s1_tdpi =
    type    : text
    content : "TD($\lambda$)-PI : évaluer $\pi_n$ pendant $N$ pas, \textit{puis} améliorer"
    pos     : (50%, 78%)
    size    : 34px

deffigure s1_d_td =
    type  : equation
    expr  : \mathcal{D}_{k+1} = -Q_\theta(x_k,u_k) + c_k + Q_\theta\big(x_{k+1},\, \pi(x_{k+1})\big)
    pos   : (50%, 68%)
    style : formule

deffigure s1_ql =
    type    : text
    content : "Q($\lambda$) : à \textit{chaque} pas, la cible prend la meilleure action selon $Q_\theta$"
    pos     : (50%, 52%)
    size    : 34px

deffigure s1_d_q =
    type  : equation
    expr  : \mathcal{D}_{k+1} = -Q_\theta(x_k,u_k) + c_k + \min_{u} Q_\theta(x_{k+1},\, u)
    pos   : (50%, 42%)
    style : formule

deffigure s1_bellman =
    type  : equation
    expr  : \text{C'est Bellman pour l'optimum : } Q^\star(x,u) = c(x,u) + \min_w Q^\star\big(F(x,u),\, w\big)
    pos   : (50%, 27%)
    size  : 34px
    color : #16A34A

deffigure s1_vi =
    type    : text
    content : "→ on apprend $Q^\star$ directement, sans politique intermédiaire (esprit « value iteration »)"
    pos     : (50%, 18%)
    style   : note

defgroup g_s1 =
    items : [s1_titre, s1_tdpi, s1_d_td, s1_ql, s1_d_q, s1_bellman, s1_vi]

# ═════════════ 2. Off-policy ═════════════

deffigure s2_titre =
    type    : text
    content : "Deux politiques différentes : off-policy"
    pos     : (50%, 91%)
    style   : titre_scene

deffigure boite_comp =
    type          : rect
    pos           : (27%, 60%)
    width         : 62%
    height        : 34%
    corner_radius : 2%
    color         : #EA580C
    fill          : #FFF7ED
    stroke        : 3px

deffigure boite_cible =
    type          : rect
    pos           : (73%, 60%)
    width         : 62%
    height        : 34%
    corner_radius : 2%
    color         : #16A34A
    fill          : #F0FDF4
    stroke        : 3px

deffigure t_comp =
    type    : text
    content : "\textbf{Politique de comportement}
celle qu'on \textit{applique} au système

explore : parfois une action au hasard
($\varepsilon$-gloutonne, signal de sondage...)

→ génère les données $(x_k, u_k, x_{k+1})$"
    pos     : (27%, 60%)
    size    : 28px
    color   : #9A3412
    layer   : 1

deffigure t_cible =
    type    : text
    content : "\textbf{Politique cible}
celle qu'on \textit{apprend}

gloutonne : $\arg\min_u Q_\theta(x, u)$

→ apparaît seulement dans la cible,
via $\min_u Q_\theta(x_{k+1}, u)$"
    pos     : (73%, 60%)
    size    : 28px
    color   : #14532D
    layer   : 1

deffigure s2_pourquoi =
    type    : text
    content : "Sans exploration, on ne testerait jamais les autres actions :
$Q_\theta(x, u)$ resterait inconnue pour tous les $u \neq$ action gloutonne"
    pos     : (50%, 25%)
    style   : note

defgroup g_s2 =
    items : [s2_titre, boite_comp, boite_cible, t_comp, t_cible, s2_pourquoi]

# ═════════════ 3-7. L'exemple ═════════════

deffigure ex_titre =
    type    : text
    content : "Un exemple : apprendre en explorant"
    pos     : (40%, 94%)
    style   : titre_scene

# --- La chaîne S → M → but ---

deffigure n_s =
    type   : circle
    center : (14%, 50%)
    style  : noeud

deffigure n_m =
    type   : circle
    center : (40%, 50%)
    style  : noeud

deffigure n_g =
    type   : circle
    center : (64%, 50%)
    style  : noeud
    fill   : #DCFCE7
    color  : #16A34A

deffigure l_s =
    type    : text
    content : "$S$"
    pos     : (14%, 50%)
    size    : 36px
    layer   : 3

deffigure l_m =
    type    : text
    content : "$M$"
    pos     : (40%, 50%)
    size    : 36px
    layer   : 3

deffigure l_g =
    type    : text
    content : "but"
    pos     : (64%, 42.5%)
    size    : 26px
    color   : #16A34A

deffigure f_sm =
    type  : line
    from  : (16.3%, 50%)
    to    : (37.7%, 50%)
    style : fleche

deffigure f_mg =
    type  : line
    from  : (42.3%, 50%)
    to    : (61.7%, 50%)
    style : fleche

deffigure lab_sm =
    type    : text
    content : "avancer, $c = 1$"
    pos     : (27%, 46%)
    size    : 24px
    color   : #1D4ED8

deffigure lab_mg =
    type    : text
    content : "avancer, $c = 1$"
    pos     : (52%, 46%)
    size    : 24px
    color   : #1D4ED8

deffigure boucle_s =
    type       : arc
    center     : (14%, 58%)
    radius     : 3%
    from_angle : -50
    to_angle   : 230
    style      : boucle

deffigure boucle_m =
    type       : arc
    center     : (40%, 58%)
    radius     : 3%
    from_angle : -50
    to_angle   : 230
    style      : boucle

deffigure lab_bs =
    type    : text
    content : "attendre, $c = 2$"
    pos     : (14%, 64.5%)
    size    : 24px
    color   : #6D28D9

deffigure lab_bm =
    type    : text
    content : "attendre, $c = 2$"
    pos     : (40%, 64.5%)
    size    : 24px
    color   : #6D28D9

deffigure agent =
    type   : circle
    center : (14%, 50%)
    radius : 4.6%
    fill   : none
    color  : #DC2626
    stroke : 5px
    layer  : 5

# --- Barres Q sous les nœuds (base à 16 %, 5 % par unité) ---

deffigure b_sa =
    type   : polygon
    points : [(11%, 16%), (13.5%, 16%), (13.5%, (16 + 5*SA)%), (11%, (16 + 5*SA)%)]
    style  : barre_av

deffigure b_sw =
    type   : polygon
    points : [(14.5%, 16%), (17%, 16%), (17%, (16 + 5*SW)%), (14.5%, (16 + 5*SW)%)]
    style  : barre_att

deffigure b_ma =
    type   : polygon
    points : [(37%, 16%), (39.5%, 16%), (39.5%, (16 + 5*MA)%), (37%, (16 + 5*MA)%)]
    style  : barre_av

deffigure b_mw =
    type   : polygon
    points : [(40.5%, 16%), (43%, 16%), (43%, (16 + 5*MW)%), (40.5%, (16 + 5*MW)%)]
    style  : barre_att

deffigure v_sa =
    type    : text
    content : "#{SA}"
    pos     : (12.25%, (18.5 + 5*SA)%)
    style   : valeur
    color   : #1D4ED8

deffigure v_sw =
    type    : text
    content : "#{SW}"
    pos     : (15.75%, (18.5 + 5*SW)%)
    style   : valeur
    color   : #6D28D9

deffigure v_ma =
    type    : text
    content : "#{MA}"
    pos     : (38.25%, (18.5 + 5*MA)%)
    style   : valeur
    color   : #1D4ED8

deffigure v_mw =
    type    : text
    content : "#{MW}"
    pos     : (41.75%, (18.5 + 5*MW)%)
    style   : valeur
    color   : #6D28D9

deffigure leg_av =
    type    : text
    content : "$Q_\theta(\cdot, \text{avancer})$"
    pos     : (64%, 30%)
    size    : 26px
    color   : #1D4ED8

deffigure leg_att =
    type    : text
    content : "$Q_\theta(\cdot, \text{attendre})$"
    pos     : (64%, 23%)
    size    : 26px
    color   : #6D28D9

# --- Tableaux à droite : Q et trace ---

deffigure nom_qtab =
    type    : text
    content : "Estimations $Q_\theta$"
    pos     : (88%, 86%)
    size    : 28px
    color   : #1E3A8A

defmodel case(x, y) =
    type   : rect
    pos    : (@x%, @y%)
    width  : 7.5%
    height : 7.5%
    color  : #9CA3AF
    stroke : 2px
    fill   : white
    layer  : 1

deffigure qc_h00 = case(83.78, 79.5)
deffigure qc_h01 = case(88, 79.5)
deffigure qc_h02 = case(92.22, 79.5)
deffigure qc_h10 = case(83.78, 72)
deffigure qc_sa = case(88, 72)
deffigure qc_sw = case(92.22, 72)
deffigure qc_h20 = case(83.78, 64.5)
deffigure qc_ma = case(88, 64.5)
deffigure qc_mw = case(92.22, 64.5)
deffigure qct_h00 =
    type    : text
    content : "$Q$"
    pos     : (83.78%, 79.5%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_h01 =
    type    : text
    content : "av"
    pos     : (88%, 79.5%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_h02 =
    type    : text
    content : "att"
    pos     : (92.22%, 79.5%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_h10 =
    type    : text
    content : "$S$"
    pos     : (83.78%, 72%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_sa =
    type    : text
    content : "#{SA}"
    pos     : (88%, 72%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_sw =
    type    : text
    content : "#{SW}"
    pos     : (92.22%, 72%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_h20 =
    type    : text
    content : "$M$"
    pos     : (83.78%, 64.5%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_ma =
    type    : text
    content : "#{MA}"
    pos     : (88%, 64.5%)
    size    : 26px
    color   : black
    layer   : 2

deffigure qct_mw =
    type    : text
    content : "#{MW}"
    pos     : (92.22%, 64.5%)
    size    : 26px
    color   : black
    layer   : 2

defgroup g_qtab =
    items : [qc_h00, qc_h01, qc_h02, qc_h10, qc_sa, qc_sw, qc_h20, qc_ma, qc_mw, qct_h00, qct_h01, qct_h02, qct_h10, qct_sa, qct_sw, qct_h20, qct_ma, qct_mw]

deffigure nom_etab =
    type    : text
    content : "Trace $e$"
    pos     : (88%, 52%)
    size    : 28px
    color   : #B45309

deffigure ec_h00 = case(83.78, 45.5)
deffigure ec_h01 = case(88, 45.5)
deffigure ec_h02 = case(92.22, 45.5)
deffigure ec_h10 = case(83.78, 38)
deffigure ec_sa = case(88, 38)
deffigure ec_sw = case(92.22, 38)
deffigure ec_h20 = case(83.78, 30.5)
deffigure ec_ma = case(88, 30.5)
deffigure ec_mw = case(92.22, 30.5)
deffigure ect_h00 =
    type    : text
    content : "$e$"
    pos     : (83.78%, 45.5%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_h01 =
    type    : text
    content : "av"
    pos     : (88%, 45.5%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_h02 =
    type    : text
    content : "att"
    pos     : (92.22%, 45.5%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_h10 =
    type    : text
    content : "$S$"
    pos     : (83.78%, 38%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_sa =
    type    : text
    content : "#{tSA}"
    pos     : (88%, 38%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_sw =
    type    : text
    content : "#{tSW}"
    pos     : (92.22%, 38%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_h20 =
    type    : text
    content : "$M$"
    pos     : (83.78%, 30.5%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_ma =
    type    : text
    content : "#{tMA}"
    pos     : (88%, 30.5%)
    size    : 26px
    color   : #B45309
    layer   : 2

deffigure ect_mw =
    type    : text
    content : "#{tMW}"
    pos     : (92.22%, 30.5%)
