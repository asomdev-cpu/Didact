    anim    : [qc_sa fill(to=#BFDBFE, 0.5s)]
    comment : ["Premier pas. En S, avancer vaut 2, attendre vaut 4 : avancer est l'action gloutonne. La politique de comportement la choisit."]
}

117.000 => {
    anim    : [agent move(to=(40%, 50%), 0.8s), tSA to(1, 0.6s, ease=smooth), ec_sa fill(to=#FDE68A, 0.5s)]
    comment : ["L'action est gloutonne : la trace est multipliée par lambda, puis on ajoute un sur la case S avancer."]
}

122.000 => {
    start   : [p1_b fadein(1s)]
    anim    : [qc_ma fill(to=#BBF7D0, 0.5s)]
