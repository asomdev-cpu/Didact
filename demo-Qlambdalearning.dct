    anim    : [agent move(to=(64%, 50%), 0.8s), tMW to(0.5, 0.8s, ease=smooth), tMA to(1, 0.8s, ease=smooth), ec_ma fill(to=#FDE68A, 0.5s), qc_ma fill(to=#BFDBFE, 0.5s)]
    comment : ["Troisième pas. En M, l'agent avance : c'est glouton, donc la trace continue. M attendre est divisé par deux, et M avancer passe à 1."]
