    layer   : 2

defgroup g_etab =
    items : [ec_h00, ec_h01, ec_h02, ec_h10, ec_sa, ec_sw, ec_h20, ec_ma, ec_mw, ect_h00, ect_h01, ect_h02, ect_h10, ect_sa, ect_sw, ect_h20, ect_ma, ect_mw]

deffigure qstar =
    type    : text
    content : "Valeurs exactes :
$Q^\star(M, \text{av}) = 1$, $Q^\star(M, \text{att}) = 2 + 1 = 3$
$Q^\star(S, \text{av}) = 1 + 1 = 2$, $Q^\star(S, \text{att}) = 2 + 2 = 4$"
    pos     : (38%, 80%)
    size    : 28px
    color   : #16A34A

deffigure params =
    type    : text
    content : "Estimations en cours d'apprentissage
$\alpha = 0{,}5$,  $\lambda = 0{,}5$"
    pos     : (88%, 22.5%)
    size    : 22px
    color   : #4B5563

# --- Pas 1 : en S, action gloutonne ---

deffigure p1_a =
    type    : text
    content : "Pas 1 : en $S$, on choisit « avancer » — gloutonne, car $2 < 4$"
    pos     : (38%, 85%)
    style   : calcul

deffigure p1_b =
    type  : equation
    expr  : \mathcal{D} = -Q(S,\text{av}) + c + \min_u Q(M,u) = -2 + 1 + 0{,}5 = -0{,}5
    pos   : (38%, 78%)
    size  : 34px
    color : #DC2626

deffigure p1_c =
    type  : equation
    expr  : Q(S,\text{av}) \leftarrow 2 + 0{,}5 \times (-0{,}5) \times e(S,\text{av}) = 1{,}75
    pos   : (38%, 71.5%)
    size  : 34px
    color : #2563EB

# --- Pas 2 : exploration en M ---

deffigure p2_a =
    type    : text
    content : "Pas 2 : en $M$, on \textbf{explore} : « attendre » — pas gloutonne ($3 > 0{,}5$)"
    pos     : (38%, 85%)
    style   : calcul
    color   : #EA580C

deffigure p2_b =
    type    : text
    content : "→ on \textbf{coupe la trace} : $e \leftarrow \psi(M, \text{att})$"
    pos     : (38%, 78.5%)
    style   : calcul
    color   : #B45309

deffigure p2_c =
    type  : equation
    expr  : \mathcal{D} = -3 + 2 + \min_u Q(M,u) = -3 + 2 + 0{,}5 = -0{,}5 \quad\Rightarrow\quad Q(M,\text{att}) = 2{,}75
    pos   : (38%, 72%)
    size  : 32px
    color : #DC2626

deffigure explo =
    type    : text
    content : "exploration !"
    pos     : (51%, 60%)
    size    : 30px
    color   : #EA580C

deffigure pourquoi =
    type    : text
    content : "Pourquoi couper ?
Ce coût vient d'une action que la
politique gloutonne n'aurait \textit{jamais}
prise. Il ne dit rien sur $Q^\star(S, \text{av})$ :
depuis $S$, l'optimum continue par « avancer »."
    pos     : (62%, 25%)
    size    : 22px
    color   : #9A3412

# --- Pas 3 : retour au glouton ---

deffigure p3_a =
    type    : text
    content : "Pas 3 : en $M$, « avancer » — gloutonne : la trace continue"
    pos     : (38%, 85%)
    style   : calcul

deffigure p3_b =
    type  : equation
    expr  : e = \lambda\, e + \psi(M,\text{av}), \qquad \mathcal{D} = -0{,}5 + 1 + 0 = 0{,}5 \quad (\text{but : } Q = 0)
    pos   : (38%, 78%)
    size  : 32px
    color : #DC2626

deffigure p3_c =
    type  : equation
    expr  : Q(M,\text{av}) \leftarrow 0{,}5 + 0{,}25 \times 1 = 0{,}75, \qquad Q(M,\text{att}) \leftarrow 2{,}75 + 0{,}25 \times 0{,}5 \approx 2{,}88
    pos   : (38%, 71.5%)
    size  : 30px
    color : #2563EB

# --- Convergence ---

deffigure conv_a =
    type    : text
    content : "Après de nombreux épisodes : $Q_\theta \to Q^\star$"
    pos     : (38%, 84%)
    size    : 36px
    color   : #16A34A

deffigure conv_b =
    type  : equation
    expr  : \pi^\star(x) \in \arg\min_u Q_\theta(x, u) = \text{avancer} \quad \text{en } S \text{ et en } M
    pos   : (38%, 76%)
    size  : 34px
    color : #1E3A8A

defgroup g_ex =
    items : [ex_titre, n_s, n_m, n_g, l_s, l_m, l_g, f_sm, f_mg, lab_sm, lab_mg, boucle_s, boucle_m, lab_bs, lab_bm, agent, b_sa, b_sw, b_ma, b_mw, v_sa, v_sw, v_ma, v_mw, leg_av, leg_att, nom_qtab, g_qtab, nom_etab, g_etab, qstar, params, p1_a, p1_b, p1_c, p2_a, p2_b, p2_c, explo, pourquoi, p3_a, p3_b, p3_c, conv_a, conv_b]

# ═════════════ 8. Algorithme ═════════════

deffigure s8_titre =
    type    : text
    content : "Q($\lambda$) de Watkins, $Q_\theta = \theta^\top\psi$"
    pos     : (50%, 92%)
    style   : titre_scene

deffigure a0 =
    type    : text
    content : "Entrées : transitions d'une politique \textit{exploratoire}, features $\psi$, $\lambda \in [0,1]$, pas $\alpha_k$, $\theta_0$ ;  $e_{-1} = 0$"
    pos     : (6%, 81%)
    align   : left
    size    : 28px
    color   : #4B5563

deffigure a1 =
    type    : text
    content : "1.  Actions gloutonnes en $x_k$ :  $U^\star_k = \arg\min_u Q_{\theta_k}(x_k, u)$"
    pos     : (6%, 71%)
    align   : left
    size    : 32px

deffigure a2 =
    type    : text
    content : "2.  Trace :  $e_k = \lambda\, e_{k-1} + \psi(k)$ si $u_k \in U^\star_k$,  sinon  $e_k = \psi(k)$  (coupure)"
    pos     : (6%, 62%)
    align   : left
    size    : 32px
    color   : #B45309

deffigure a3 =
    type    : text
    content : "3.  Action gloutonne à l'état suivant :  $u^\star_{k+1} \in \arg\min_u Q_{\theta_k}(x_{k+1}, u)$"
    pos     : (6%, 53%)
    align   : left
    size    : 32px
    color   : #16A34A

deffigure a4 =
    type    : text
    content : "4.  $\mathcal{D}_{k+1} = -Q_{\theta_k}(x_k, u_k) + c_k + Q_{\theta_k}(x_{k+1}, u^\star_{k+1})$"
    pos     : (6%, 44%)
    align   : left
    size    : 32px
    color   : #DC2626

deffigure a5 =
    type    : text
    content : "5.  $\theta_{k+1} = \theta_k + \alpha_{k+1}\, \mathcal{D}_{k+1}\, e_k$"
    pos     : (6%, 35%)
    align   : left
    size    : 32px
    color   : #2563EB

deffigure a6 =
    type    : text
    content : "6.  Sortie : $Q_{\theta_N}$ et la politique $\pi^\star_N(x) \in \arg\min_u Q_{\theta_N}(x, u)$"
    pos     : (6%, 26%)
    align   : left
    size    : 32px

deffigure a7 =
    type    : text
    content : "$\lambda = 0$ :  $e_k = \psi(k)$, c'est le Q-learning classique (Q(0)), base de DQN"
    pos     : (50%, 19%)
    style   : note

defgroup g_s8 =
    items : [s8_titre, a0, a1, a2, a3, a4, a5, a6, a7]

# ═════════════ 9. Comparaison ═════════════

deffigure s9_titre =
    type    : text
    content : "TD($\lambda$)-PI ou Q($\lambda$) ?"
    pos     : (50%, 91%)
    style   : titre_scene

deffigure s9_table =
    type   : table
    pos    : (50%, 58%)
    size   : 32px
    header : ["Critère", "TD($\lambda$)-PI", "Q($\lambda$)"]
    rows   : |
        Ce qu'on apprend | $Q^{\pi_n}$, puis on améliore | $Q^\star$ directement
        Action dans la cible | $\pi_n(x_{k+1})$, fixée | $\arg\min_u Q_\theta(x_{k+1}, u)$
        Évaluation / amélioration | séparées | mélangées à chaque pas
        Données | celles de $\pi_n$ (+ exploration) | n'importe quelle politique exploratoire
        Trace | toujours $\lambda e_{k-1} + \psi(k)$ | coupée après une action non gloutonne

deffigure s9_note =
    type    : text
    content : "Limite : beaucoup d'exploration ⇒ coupures fréquentes ⇒ traces courtes, peu de gain par rapport à $\lambda = 0$
Off-policy + bootstrapping + approximation : pas de garantie de convergence en général"
    pos     : (50%, 22%)
    size    : 28px
    color   : #4B5563

defgroup g_s9 =
    items : [s9_titre, s9_table, s9_note]

# ═════════════ 10. Récapitulatif ═════════════

deffigure s10_titre =
    type    : text
    content : "À retenir"
    pos     : (50%, 88%)
    style   : titre_scene

deffigure r_1 =
    type    : text
    content : "• Cible gloutonne : $c_k + \min_u Q_\theta(x_{k+1}, u)$ — on apprend $Q^\star$, pas $Q^\pi$"
    pos     : (10%, 74%)
    align   : left
    size    : 34px

deffigure r_2 =
    type    : text
    content : "• Off-policy : on explore pour agir, on reste glouton pour apprendre"
    pos     : (10%, 63%)
    align   : left
    size    : 34px

deffigure r_3 =
    type    : text
    content : "• Trace de Watkins : coupée dès qu'une action n'est pas gloutonne"
    pos     : (10%, 52%)
    align   : left
    size    : 34px

deffigure r_4 =
    type    : text
    content : "• Évaluation et amélioration à chaque pas, plus de politique $\pi_n$ fixée"
    pos     : (10%, 41%)
    align   : left
    size    : 34px

deffigure r_5 =
    type    : text
    content : "• Politique finale : $\pi^\star(x) \in \arg\min_u Q_{\theta_N}(x, u)$"
    pos     : (10%, 30%)
    align   : left
    size    : 34px

defgroup g_s10 =
    items : [s10_titre, r_1, r_2, r_3, r_4, r_5]

[timeline]

# ═════════════ 0. Titre ═════════════

0.000 => {
    start   : [titre fadein(1s), sous_titre fadein(1.5s), source fadein(1.5s)]
    comment : ["Dans cette vidéo : le Q lambda learning de Watkins, qui apprend directement la fonction Q optimale tout en explorant."]
}

7.000 => {
    end : [g_titre fadeout(0.8s)]
}

# ═════════════ 1. La cible devient gloutonne ═════════════

8.000 => {
    start   : [s1_titre fadein(0.8s), s1_tdpi fadein(1s), s1_d_td write(1.5s)]
    comment : ["Avec TD lambda PI, on évalue une politique pi n fixée pendant N pas, puis on l'améliore. Dans la cible, l'action suivante est celle de pi n."]
}

16.000 => {
    anim    : [s1_d_td color(to=#EA580C, 0.6s, part="\pi(x_{k+1})")]
    comment : ["Le point clé, c'est ce terme : la politique qu'on évalue."]
}

21.000 => {
    start   : [s1_ql fadein(1s), s1_d_q write(1.5s)]
    comment : ["Q lambda remplace ce terme par le minimum sur u : à chaque pas, la cible suppose qu'on prendra ensuite la meilleure action selon l'estimation actuelle."]
}

27.500 => {
    anim : [s1_d_q color(to=#16A34A, 0.6s, part="\min_{u} Q_\theta(x_{k+1},\, u)")]
}

31.000 => {
    start   : [s1_bellman fadein(1s)]
    comment : ["C'est exactement l'équation de Bellman pour la fonction Q optimale."]
}

37.000 => {
    start   : [s1_vi fadein(1s)]
    comment : ["On apprend donc Q étoile directement, sans passer par une suite de politiques : c'est l'esprit de la value iteration."]
}

44.000 => {
    end : [g_s1 fadeout(0.8s)]
}

# ═════════════ 2. Off-policy ═════════════

45.000 => {
    start   : [s2_titre fadein(0.8s), boite_comp grow(0.6s), t_comp fadein(1s)]
    comment : ["Il y a maintenant deux politiques. La politique de comportement est celle qu'on applique au système : elle explore, en choisissant parfois une action au hasard."]
}

54.000 => {
    start   : [boite_cible grow(0.6s), t_cible fadein(1s)]
    comment : ["La politique cible est celle qu'on apprend : gloutonne par rapport à Q. Elle n'est jamais appliquée, elle apparaît seulement dans le minimum de la cible."]
}

63.000 => {
    start   : [s2_pourquoi fadein(1s)]
    comment : ["Sans exploration, on ne testerait jamais les autres actions, et leur valeur resterait inconnue. C'est l'apprentissage off-policy."]
}

72.000 => {
    end : [g_s2 fadeout(0.8s)]
}

# ═════════════ 3. L'exemple : mise en place ═════════════

73.000 => {
    start   : [ex_titre fadein(0.8s), n_s grow(0.5s), n_m grow(0.5s), n_g grow(0.5s), l_s fadein(0.8s), l_m fadein(0.8s), l_g fadein(0.8s), f_sm draw(1s), f_mg draw(1s), lab_sm fadein(1s), lab_mg fadein(1s)]
    comment : ["Prenons une chaîne : S, M, puis le but. Dans chaque état, on peut avancer, pour un coût de 1,"]
}

79.000 => {
    start   : [boucle_s draw(1s), boucle_m draw(1s), lab_bs fadein(1s), lab_bm fadein(1s)]
    comment : ["ou attendre sur place, pour un coût de 2. Une feature par couple état-action : c'est un tableau de quatre valeurs."]
}

86.000 => {
    start   : [qstar fadein(1s)]
    comment : ["Les vraies valeurs se calculent à la main. Depuis M, avancer coûte 1 ; attendre coûte 2, plus 1 ensuite. Depuis S : 2 et 4."]
}

95.000 => {
    end     : [qstar fadeout(0.6s)]
    start   : [b_sa, b_sw, b_ma, b_mw, v_sa fadein(0.6s), v_sw fadein(0.6s), v_ma fadein(0.6s), v_mw fadein(0.6s), leg_av fadein(0.8s), leg_att fadein(0.8s), nom_qtab fadein(0.8s), g_qtab fadein(1s), params fadein(0.8s)]
    comment : ["Voici nos estimations actuelles, en cours d'apprentissage. Elles sont presque justes, sauf Q de M avancer, sous-estimé à 0,5. Pas alpha 0,5, lambda 0,5."]
}

104.000 => {
    start   : [nom_etab fadein(0.8s), g_etab fadein(1s), agent grow(0.5s)]
    comment : ["En dessous, la trace d'éligibilité, une case par couple état-action, nulle au départ. L'agent part de S."]
}

# ═════════════ 4. Pas 1 : action gloutonne ═════════════

110.000 => {
