173.000 => {
    anim : [agent move(to=(30%, 45%), 0.6s)]
}

174.500 => {
    anim : [agent move(to=(46%, 45%), 0.6s)]
}

176.000 => {
    start   : [d_cd5 fadein(0.5s)]
    anim    : [agent move(to=(62%, 45%), 0.8s)]
    comment : ["De C à D : la cible vaut 0 plus Q de D, soit 5. Donc D vaut 5, et Q de C monte à 2,5."]
}

178.000 => {
    anim : [qC to(2.5, 1.2s, ease=smooth)]
}

182.000 => {
    end     : [d_cd5 fadeout(0.4s)]
    start   : [d_dg5 fadein(0.5s)]
    anim    : [agent move(to=(80%, 45%), 0.8s)]
    comment : ["Puis de D au but : D vaut 10 moins 5, égal 5, et Q de D monte à 7,5."]
