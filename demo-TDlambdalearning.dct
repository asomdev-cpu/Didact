    anim    : [bilan_td0 [scale(1.15, 0.4s), scale(1, 0.4s)]]
    comment : ["L'information remonte d'un seul état par épisode. Il faudra quatre épisodes pour que A apprenne quoi que ce soit."]
}

# ═════════════ 5. La trace d'éligibilité : TD(λ) ═════════════

196.000 => {
    end     : [s4_titre fadeout(0.5s), ep2 fadeout(0.4s), bilan_td0 fadeout(0.4s)]
    start   : [s5_titre fadein(0.8s), ep3 fadein(0.6s), be_a, be_b, be_c, be_d, ve_a fadein(0.6s), ve_b fadein(0.6s), ve_c fadein(0.6s), ve_d fadein(0.6s), nom_e fadein(0.8s)]
    anim    : [qC to(0, 0.8s), qD to(0, 0.8s), agent move(to=(14%, 45%), 0.8s)]
    comment : ["TD lambda règle ce problème avec une trace d'éligibilité, en orange : la mémoire des états récemment visités. On repart de zéro."]
}

204.000 => {
    comment : ["À chaque pas, la trace est multipliée par lambda, puis on ajoute le vecteur de l'état courant. Ici lambda vaut 0,5."]
}

210.000 => {
    anim    : [eA to(1, 0.6s, ease=smooth)]
    comment : ["En A, la trace vaut 1 sur A. D est nul : theta ne bouge pas, mais la trace s'en souvient."]
}

215.000 => {
    anim    : [agent move(to=(30%, 45%), 0.8s), eA to(0.5, 0.6s, ease=smooth), eB to(1, 0.6s, ease=smooth)]
    comment : ["On passe en B : le poids de A est divisé par deux, B vaut 1."]
}

219.000 => {
    anim    : [agent move(to=(46%, 45%), 0.8s), eA to(0.25, 0.6s, ease=smooth), eB to(0.5, 0.6s, ease=smooth), eC to(1, 0.6s, ease=smooth)]
    comment : ["Puis C. Plus un état est ancien, plus son poids est faible : lambda puissance son âge."]
}

224.000 => {
    anim    : [agent move(to=(62%, 45%), 0.8s), eA to(0.125, 0.6s, ease=smooth), eB to(0.25, 0.6s, ease=smooth), eC to(0.5, 0.6s, ease=smooth), eD to(1, 0.6s, ease=smooth)]
}

227.000 => {
    start   : [d_dg10 fadein(0.5s)]
    anim    : [agent move(to=(80%, 45%), 0.8s)]
    comment : ["Au dernier pas, D vaut 10. Cette fois, la correction suit toute la trace, et pas seulement l'état courant."]
}

232.000 => {
    start   : [maj_lambda fadein(0.8s)]
    anim    : [qD to(5, 1.5s, ease=smooth), qC to(2.5, 1.5s, ease=smooth), qB to(1.25, 1.5s, ease=smooth), qA to(0.625, 1.5s, ease=smooth)]
    comment : ["D gagne 5, C 2,5, B 1,25, et A 0,63. Dès le premier épisode, tout le chemin qui a mené au coût a appris."]
}

241.000 => {
    end     : [ep3 fadeout(0.4s), maj_lambda fadeout(0.4s)]
    start   : [ep4 fadein(0.6s)]
    anim    : [eA to(1, 1s, ease=smooth), eB to(1, 1s, ease=smooth), eC to(1, 1s, ease=smooth), qA to(5, 1.5s, ease=smooth), qB to(5, 1.5s, ease=smooth), qC to(5, 1.5s, ease=smooth)]
    comment : ["Avec lambda égal 1, la trace ne s'efface jamais : tous les états reçoivent la même correction. C'est l'esprit Monte-Carlo, qui s'appuie sur les coûts réellement payés."]
}

251.000 => {
    end : [g_chaine fadeout(0.8s)]
}

# ═════════════ 6. Compromis ═════════════

252.000 => {
    start   : [s6_titre fadein(0.8s), s6_table fadein(1.2s)]
    comment : ["Lambda règle donc un compromis. Avec lambda égal 0, on s'appuie sur un seul pas et sur l'estimation de Q : peu de variance, mais un biais si Q est mal approchée."]
}

261.000 => {
    comment : ["Avec lambda égal 1, on s'appuie sur les coûts réels de toute la suite : peu de biais, mais ces coûts accumulés sont bruités, donc beaucoup de variance."]
}

269.000 => {
    start   : [s6_note fadein(1s)]
    comment : ["Un grand lambda propage plus vite un coût retardé. En revanche, la convergence n'est garantie que pour lambda égal 0, avec des données on-policy."]
}

278.000 => {
    end : [g_s6 fadeout(0.8s)]
}

# ═════════════ 7. Algorithme ═════════════

279.000 => {
    start   : [s7_titre fadein(0.8s), a0 fadein(1s), a1 fadein(1s)]
    comment : ["Voici l'algorithme complet. On part d'une trace nulle."]
}

284.000 => {
    start   : [a2 write(1.2s)]
    comment : ["À chaque transition : on met à jour la trace,"]
}

288.000 => {
    start   : [a3 write(1.5s)]
    comment : ["on calcule la différence temporelle avec le theta actuel,"]
}

292.000 => {
    start   : [a4 write(1.2s)]
    comment : ["et on corrige theta dans la direction de la trace, et non plus de psi seul."]
}

297.000 => {
    start   : [a5 fadein(1s), a6 fadein(1s)]
    comment : ["Chaque mise à jour ne coûte que de l'ordre de d opérations. Et avec lambda égal 0, la trace vaut psi : on retrouve TD zéro."]
}

305.000 => {
    end : [g_s7 fadeout(0.8s)]
}

# ═════════════ 8. Non linéaire et TD(λ)-PI ═════════════

306.000 => {
    start   : [s8_titre fadein(0.8s), nl1 write(1.2s), nl2 write(1.2s), sep draw(0.8s)]
    comment : ["Si Q est un réseau de neurones, on remplace psi par le gradient de Q par rapport à theta."]
}

312.000 => {
    start   : [nl3 fadein(1s)]
    comment : ["C'est cohérent : dans le cas linéaire, ce gradient vaut exactement psi. Mais on perd la garantie de convergence."]
}

320.000 => {
    start   : [s8b_titre fadein(0.8s), pi1 fadein(0.8s), pi2 fadein(0.8s), pi3 fadein(0.8s), pi4 fadein(0.8s)]
    comment : ["Enfin, TD lambda ne fait qu'évaluer. Pour améliorer la politique, on l'insère dans une policy iteration : collecter, évaluer, prendre l'argmin, et repartir du theta précédent."]
}

330.000 => {
